dist.new/
dist.failed/
.context/
.env*
!.env.example
.envrc
.DS_Store
.impeccable/
dist-addon/

# client-package.json is the only tracked file here (the old guest page is gone; /app/index.html becomes a redirect, #133)
cloud/catalyst-relay/client/*
!cloud/catalyst-relay/client/client-package.json

.ship-deps-stamp
.ship-host-commit
firepit-log.txt
firebase/*.log
cloud/catalyst-relay/live/build/
