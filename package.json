{
  "name": "squeak",
  "version": "2.0.0",
  "private": true,
  "description": "A pager for your coding agents: a native Mac app, an iPhone app and Telegram cards that tell you what needs you and let you answer.",
  "type": "module",
  "bin": {
    "squeak": "dist/squeak/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && scripts/addons.sh build",
    "dev": "tsx watch src/squeak/cli.ts start",
    "start": "tsx src/squeak/cli.ts start",
    "typecheck": "tsc -p tsconfig.json --noEmit && scripts/addons.sh check",
    "lint": "eslint --no-error-on-unmatched-pattern src/ web/ addons/",
    "format:check": "prettier --check --no-error-on-unmatched-pattern src/ web/ cloud/ addons/",
    "format": "prettier --write --no-error-on-unmatched-pattern src/ web/ cloud/ addons/",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "keywords": [
    "coding-agents",
    "claude",
    "codex",
    "conductor",
    "telegram",
    "pager"
  ],
  "author": "Sibhimanyu",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sibhimanyu/squeak.git"
  },
  "bugs": {
    "url": "https://github.com/Sibhimanyu/squeak/issues"
  },
  "homepage": "https://github.com/Sibhimanyu/squeak#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.319",
    "better-sqlite3": "^12.8.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "esbuild": "0.27.4",
    "eslint": "^10.1.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.1.2"
  }
}
