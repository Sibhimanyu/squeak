{
  "name": "squeak-website",
  "version": "1.0.0",
  "private": true,
  "description": "Static marketing page for Squeak (built to dist/, served at / and /squeak/)",
  "type": "module",
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "build": "tsx scripts/build.ts",
    "dev": "tsx scripts/dev.ts",
    "typecheck": "tsc -p scripts/tsconfig.json",
    "verify": "npm run typecheck && tsx scripts/verify.ts",
    "release": "node scripts/release-meta.mjs"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lenis": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "playwright": "1.64.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
