TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
BRIDGE_DB_PATH=.context/bridge.db
CONDUCTOR_DB_PATH=~/Library/Application Support/com.conductor.app/conductor.db
CODEX_BIN=~/Library/Application Support/com.conductor.app/bin/codex
CLAUDE_BIN=~/Library/Application Support/com.conductor.app/bin/claude
WORKSPACES_ROOT=~/conductor/workspaces
POLL_TIMEOUT_SECONDS=30
QUEUE_TICK_MS=750
PAGE_SIZE=12
DEFAULT_FALLBACK_MODEL=gpt-5.4
DEFAULT_PERMISSION_MODE=default

# Fleet radar: every agent session on this Mac, not just Conductor's.
FLEET_ENABLED=true
# Loopback port the installed agent hooks report to.
FLEET_HOOK_PORT=8477
FLEET_POLL_INTERVAL_MS=20000
# How far back a transcript still counts as a session worth showing.
FLEET_ACTIVE_WINDOW_MINUTES=360
# A running turn quiet for longer than this is treated as stalled.
FLEET_IDLE_AFTER_MINUTES=10
