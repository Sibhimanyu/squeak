import fs from "node:fs";
import os from "node:os";
import path from "node:path";

import { describe, expect, it, vi } from "vitest";

import { AutoTitler, cleanTitle, heuristicTitle, looksWeak, titleModel, titlePrompt } from "./auto-title.js";
import { NativeStore } from "./store.js";

function makeStore(): NativeStore {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "auto-title-"));
  return new NativeStore(path.join(dir, "native.db"));
}

function chat(store: NativeStore, text: string | null, title?: string): string {
  const s = store.createSession({ cwd: os.tmpdir(), agent: "claude", model: "m", permissionMode: "default" });
  if (text) store.appendMessage(s.id, "user", "user/text", { text });
  if (title) store.setTitle(s.id, title);
  return s.id;
}

describe("cleanTitle", () => {
  it("strips quotes, markdown and trailing punctuation", () => {
    expect(cleanTitle('"Merge branches and clean repo."')).toBe("Merge branches and clean repo");
    expect(cleanTitle("**Title:** Greenroom x Recorditor!\nextra line")).toBe("Greenroom x Recorditor");
    expect(cleanTitle("  `Fix   login`  ")).toBe("Fix login");
  });
  it("rejects empty and long answers, clips at a word", () => {
    expect(cleanTitle("   ")).toBeNull();
    expect(cleanTitle("one two three four five six seven eight nine")).toBeNull();
    const t = cleanTitle("Internationalisation infrastructure modernisation roadmap proposal");
    expect(t!.length).toBeLessThanOrEqual(48);
    expect(t!.endsWith(" ")).toBe(false);
  });
});

describe("heuristicTitle", () => {
  it("drops filler and keeps six words, Title Case", () => {
    expect(heuristicTitle("We need to merge everything we have and clean up the repo")).toBe(
      "Merge Everything We Have and Clean",
    );
    expect(heuristicTitle("Use sonnet 5.5 to code I will tell you what to do")).toBe("Code I Will Tell You What");
  });
  it("takes the first clause and keeps proper nouns", () => {
    expect(heuristicTitle("Hey, can you please fix the iOS login bug? It crashes")).toBe("Fix the iOS Login Bug");
    expect(heuristicTitle("I want to add dark mode to Squeak.\nMore detail")).toBe("Add Dark Mode to Squeak");
    expect(heuristicTitle("   ")).toBeNull();
  });
});

describe("titleModel / prompt", () => {
  it("is Haiku", () => expect(titleModel()).toBe("haiku"));
  it("clips the message and the reply", () => {
    const p = titlePrompt("a".repeat(3000), "b".repeat(900));
    expect(p.length).toBeLessThan(2200);
  });
});

const quick = { gapMs: 0, modelEnabled: () => true };

describe("AutoTitler", () => {
  it("stores the model's title and tells watchers", async () => {
    const store = makeStore();
    const id = chat(store, "We need to merge everything we have and clean up the repo");
    const onTitle = vi.fn();
    const call = vi.fn(async () => '"Merge branches and clean repo."');
    const t = new AutoTitler({ store, onTitle, call, ...quick });
    t.request(id);
    await t.idle();
    expect(store.getSession(id)).toMatchObject({ title: "Merge branches and clean repo", titleAuto: true });
    expect(onTitle).toHaveBeenCalledWith(id, "Merge branches and clean repo");
  });

  it("never overwrites a person's rename, even one made while the call ran", async () => {
    const store = makeStore();
    const named = chat(store, "hello there", "Mine");
    const racing = chat(store, "something else");
    const onTitle = vi.fn();
    const call = vi.fn(async () => {
      store.setTitle(racing, "Typed meanwhile");
      return "Auto Title";
    });
    const t = new AutoTitler({ store, onTitle, call, ...quick });
    t.request(named);
    t.request(racing);
    await t.idle();
    expect(store.getSession(named)!.title).toBe("Mine");
    expect(store.getSession(racing)).toMatchObject({ title: "Typed meanwhile", titleAuto: false });
    expect(onTitle).not.toHaveBeenCalled();
  });

  it("falls back to the heuristic on failure, a bad answer, a timeout, or the switch off", async () => {
    const store = makeStore();
    const text = "Please fix the flaky upload test";
    const ids = [chat(store, text), chat(store, text), chat(store, text), chat(store, text)];
    const run = async (id: string, call: () => Promise<string>, extra = {}): Promise<void> => {
      const t = new AutoTitler({ store, onTitle: () => undefined, call, ...quick, ...extra });
      t.request(id);
      await t.idle();
    };
    await run(ids[0]!, async () => Promise.reject(new Error("not signed in")));
    await run(ids[1]!, async () => "one two three four five six seven eight nine ten");
    await run(ids[2]!, () => new Promise<string>(() => undefined), { timeoutMs: 20 });
    const off = vi.fn(async () => "Never Used");
    await run(ids[3]!, off, { modelEnabled: () => false });
    for (const id of ids) expect(store.getSession(id)!.title).toBe("Fix the Flaky Upload Test");
    expect(off).not.toHaveBeenCalled();
  });

  it("backfills at most 15 untitled chats with a message, once each", async () => {
    const store = makeStore();
    for (let i = 0; i < 20; i++) chat(store, `Task number ${i} please`);
    const empty = chat(store, null);
    const titled = chat(store, "already named", "Kept");
    const call = vi.fn(async () => {
      throw new Error("offline");
    });
    const t = new AutoTitler({ store, onTitle: () => undefined, call, ...quick });
    const first = t.backfill();
    await t.idle();
    expect(first).toHaveLength(15);
    expect(first).not.toContain(empty);
    expect(first).not.toContain(titled);
    expect(call).toHaveBeenCalledTimes(15);
    const second = t.backfill();
    await t.idle();
    expect(second).toHaveLength(5);
    expect(second.filter((id) => first.includes(id))).toEqual([]);
    expect(t.backfill()).toEqual([]);
  });
});

function work(store: NativeStore, id: string, tools: number): void {
  for (let i = 0; i < tools; i++) {
    store.appendMessage(id, "agent", "assistant", {
      message: { content: [{ type: "tool_use", id: `t${i}`, name: "Edit", input: {} }] },
    });
  }
  store.appendMessage(id, "agent", "assistant", { message: { content: [{ type: "text", text: "Fixed the Zoom review issues." }] } });
}

describe("looksWeak", () => {
  it("flags placeholders, long titles, cut titles and copied prompts", () => {
    expect(looksWeak("New chat", null)).toBe(true);
    expect(looksWeak("Please go through the whole Zoom marketplace review feedback", null)).toBe(true);
    expect(looksWeak("Fix the thing and then…", null)).toBe(true);
    expect(looksWeak("Fix the flaky upload", "Fix the flaky upload test please")).toBe(true);
    expect(looksWeak("Zoom review fixes", "Please go through the Zoom feedback")).toBe(false);
  });
});

describe("AutoTitler retitling", () => {
  const model = (text: string) => vi.fn(async () => text);

  it("retitles once after the first finished turn with real tool work, in 3-6 plain words", async () => {
    const store = makeStore();
    const id = chat(store, "can you look at the zoom stuff", undefined);
    store.setAutoTitle(id, "Look at the Zoom Stuff");
    const call = model("Zoom Marketplace review fixes");
    const onTitle = vi.fn();
    const t = new AutoTitler({ store, onTitle, call, ...quick });
    work(store, id, 1);
    t.turnFinished(id);
    await t.idle();
    expect(call).not.toHaveBeenCalled();
    work(store, id, 3);
    t.turnFinished(id);
    await t.idle();
    expect(store.getSession(id)).toMatchObject({ title: "Zoom Marketplace review fixes", titleAuto: true });
    expect(onTitle).toHaveBeenCalledWith(id, "Zoom Marketplace review fixes");
    expect(call.mock.calls[0]![0].prompt).toContain("Fixed the Zoom review issues");
    t.turnFinished(id);
    await t.idle();
    expect(call).toHaveBeenCalledTimes(1);
  });

  it("looks again at Task done, once, and keeps the title when the scope has not shifted", async () => {
    const store = makeStore();
    const id = chat(store, "can you look at the zoom stuff");
    store.setAutoTitle(id, "Zoom Review Fixes");
    const same = model("Zoom Review Fixes");
    const t = new AutoTitler({ store, onTitle: () => undefined, call: same, ...quick });
    t.taskDone(id);
    await t.idle();
    expect(store.getSession(id)!.title).toBe("Zoom Review Fixes");
    const shifted = new AutoTitler({ store, onTitle: () => undefined, call: model("Zoom Listing And Pricing"), ...quick });
    shifted.taskDone(id);
    await shifted.idle();
    expect(store.getSession(id)!.title).toBe("Zoom Review Fixes");
  });

  it("never overwrites a title the person set, even one set during the call", async () => {
    const store = makeStore();
    const mine = chat(store, "do the thing", "My name for it");
    const racing = chat(store, "do the other thing");
    store.setAutoTitle(racing, "Do the Other Thing");
    work(store, mine, 4);
    work(store, racing, 4);
    const call = vi.fn(async () => {
      store.setTitle(racing, "Typed meanwhile");
      return "Model Title";
    });
    const t = new AutoTitler({ store, onTitle: () => undefined, call, ...quick });
    t.turnFinished(mine);
    t.turnFinished(racing);
    t.taskDone(mine);
    await t.idle();
    expect(store.getSession(mine)!.title).toBe("My name for it");
    expect(store.getSession(racing)).toMatchObject({ title: "Typed meanwhile", titleAuto: false });
  });

  it("leaves the title alone when the model fails or the switch is off", async () => {
    const store = makeStore();
    const id = chat(store, "do the thing");
    store.setAutoTitle(id, "Do the Thing");
    work(store, id, 4);
    const t = new AutoTitler({ store, onTitle: () => undefined, call: async () => Promise.reject(new Error("off")), ...quick });
    t.turnFinished(id);
    await t.idle();
    expect(store.getSession(id)!.title).toBe("Do the Thing");
  });

  it("backfills weak titles once, capped, never a person's and never a good one", async () => {
    const store = makeStore();
    const weak: string[] = [];
    for (let i = 0; i < 14; i++) weak.push(chat(store, `Task ${i} please go through everything carefully`, "New chat"));
    // older chats never recorded who named them: put "New chat" back without title_auto
    store.db.prepare("UPDATE sessions SET title_auto=NULL").run();
    const mine = chat(store, "x y", "New chat");
    const good = chat(store, "Please fix the login redirect", "Login redirect bug");
    store.db.prepare("UPDATE sessions SET title_auto=NULL WHERE id=?").run(good);
    const call = model("Tidy Task Summary");
    const t = new AutoTitler({ store, onTitle: () => undefined, call, ...quick });
    const first = t.backfillWeak();
    await t.idle();
    expect(first).toHaveLength(12);
    expect(first).not.toContain(mine);
    expect(first).not.toContain(good);
    expect(call).toHaveBeenCalledTimes(12);
    const second = t.backfillWeak();
    await t.idle();
    expect(second).toHaveLength(2);
    expect(t.backfillWeak()).toEqual([]);
    expect(store.getSession(good)!.title).toBe("Login redirect bug");
    expect(weak.length).toBe(14);
  });
});
