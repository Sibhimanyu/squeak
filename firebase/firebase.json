{
  "firestore": {
    "rules": "firestore.rules"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": [
    {
      "public": "public",
      "ignore": ["**/.*"],
      "headers": [
        {
          "source": "**/*.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ],
      "site": "squeak-5c9gvo",
      "redirects": [
        {
          "source": "/app",
          "destination": "https://squeak-mac.web.app/",
          "type": 301
        },
        {
          "source": "/app/**",
          "destination": "https://squeak-mac.web.app/",
          "type": 301
        }
      ]
    },
    {
      "site": "squeak-mac",
      "public": "web-public",
      "ignore": ["**/.*"],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src blob:; manifest-src 'self'; connect-src https://*.firebasedatabase.app https://*.firebaseio.com; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
            },
            {
              "key": "Referrer-Policy",
              "value": "no-referrer"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(self), microphone=(), geolocation=(), payment=()"
            },
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    }
  ]
}
